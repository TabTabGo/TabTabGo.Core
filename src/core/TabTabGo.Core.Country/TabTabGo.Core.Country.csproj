<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>TabTabGo Country library</Title>
    <Description>Country data (ISO codes, names in English and Arabic) and the country service.</Description>
    <PackageTags>core;country</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\countries_info.json" CopyToOutputDirectory="Always" />
    <EmbeddedResource Include="Resources\ar-AE.json" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabTabGo.Core\TabTabGo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabTabGo.Core.Country.Tests" />
  </ItemGroup>

</Project>
