<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>TabTabGo Core Api</Title>
    <Description>Reusable ASP.NET Core helpers: entity route generation (minimal API), legacy controller base, error handling and request logging middlewares.</Description>
    <PackageTags>aspnetcore;api;minimal-api;middleware</PackageTags>
    <!-- The ASP.NET route-handler analyzer of the .NET 10 SDK (seen on 10.0.401 and 10.0.404) throws a NullReferenceException
         (AD0001) on generic handlers with Results<...> return types; it is an analyzer defect, not a code issue. Conditioned on the
         SDK major, not the patch: global.json rolls forward within the feature band and CI installs a newer patch than a laptop.
         TODO: remove when the first .NET 10 SDK that fixes it is the minimum in global.json. -->
    <NoWarn Condition="$([MSBuild]::VersionLessThan('$(NETCoreSdkVersion)', '11.0.0'))">$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabTabGo.Core\TabTabGo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabTabGo.Core.Api.Tests" />
  </ItemGroup>

</Project>
