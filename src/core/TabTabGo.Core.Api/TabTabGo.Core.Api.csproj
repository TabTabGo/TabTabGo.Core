<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>TabTabGo Core Api</Title>
    <Description>Reusable ASP.NET Core helpers: entity route generation (minimal API), legacy controller base, error handling and request logging middlewares.</Description>
    <PackageTags>aspnetcore;api;minimal-api;middleware</PackageTags>
    <!-- TODO: remove on the next SDK bump. The ASP.NET route-handler analyzer of SDK 10.0.401 throws a NullReferenceException
         (AD0001) on generic handlers with Results<...> return types; it is an analyzer defect, not a code issue.
         Scoped to exactly the pinned SDK so a newer SDK reports it again. -->
    <NoWarn Condition="'$(NETCoreSdkVersion)' == '10.0.401'">$(NoWarn);AD0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TabTabGo.Core\TabTabGo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TabTabGo.Core.Api.Tests" />
  </ItemGroup>

</Project>
